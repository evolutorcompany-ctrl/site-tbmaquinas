13: /* ─── GOOGLE FONTS ─────────────────────────────────────────── */
14: @import url('https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700;900&family=Open+Sans:wght@300;400;500;600&display=swap');
15: 
16: /* ─── RESET ─────────────────────────────────────────────────── */
17: *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
18: html { scroll-behavior: smooth; font-size: 15px; }
19: 
20: /* ─── VARIÁVEIS ─────────────────────────────────────────────── */
21: :root {
22:   --primary:       #000000;
23:   --primary-hover: #424449;
24:   --accent:        #FF7B00;
25:   --accent-hover:  #e66b00;
26:   --white:         #ffffff;
27:   --light-bg:      #424449;
28:   --body-text:     #cccccc;
29:   --dark-text:     #ffffff;
30:   --border:        #4C4E52;
31:   --topbar-bg:     #000000;
32:   --nav-bg:        #000000;
33:   --footer-bg:     #000000;
34:   --footer-text:   rgba(255,255,255,0.65);
35:   --radius:        4px;
36:   --radius-lg:     8px;
37:   --shadow:        0 4px 20px rgba(0,0,0,0.1);
38:   --shadow-hover:  0 8px 32px rgba(0,0,0,0.18);
39:   --transition:    all 0.3s ease;
40:   --font-heading:  'Titillium Web', sans-serif;
41:   --font-body:     'Open Sans', sans-serif;
42:   --container:     1200px;
43:   --section-pad:   90px 0;
44:   --section-pad-sm:50px 0;
45: }
46: 
47: /* ─── BASE ──────────────────────────────────────────────────── */
48: body {
49:   font-family: var(--font-body);
50:   font-size: 15px;
51:   color: var(--body-text);
52:   line-height: 1.7;
53:   background: #000000;
54:   -webkit-font-smoothing: antialiased;
55: }
56: a { color: var(--accent); text-decoration: none; transition: var(--transition); }
57: a:hover { color: var(--accent-hover); }
58: img { max-width: 100%; height: auto; display: block; }
59: ul { list-style: none; }
